# Default: SQLite (runs immediately out of the box with zero external setup)
DATABASE_URL=sqlite:///./fuel.db

# Optional: PostgreSQL (for Docker Compose or local PostgreSQL service)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fuel_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=fuel_db
# POSTGRES_PORT=5432
